# 复制为 .env 后填写（.env 会被 gitignore，不会提交）

# DeepSeek API Key（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# 一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口
PORT=8000

# 阶段 3：用户明确授权的本地音乐目录。留空则不启用本地音乐 Provider。
# MUSIC_LIBRARY_DIR=C:\Users\你的用户名\Music
MUSIC_MAX_TRACKS=500

# 天气（和风天气 QWeather 免费版，https://dev.qweather.com 注册控制台创建项目后获取 Key）
WEATHER_API_KEY=
# 可选：默认城市（用户没提城市名时兜底，如 北京）
WEATHER_DEFAULT_CITY=
